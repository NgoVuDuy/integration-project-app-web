<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".activities.InformationProductActivity">

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:visibility="gone"
                    android:id="@+id/hinh1"
                    android:scaleType="fitXY"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_weight="1"/>

                <ImageView
                    android:visibility="gone"

                    android:id="@+id/hinh2"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:scaleType="fitXY"

                    android:layout_weight="1"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:visibility="gone"

                    android:id="@+id/hinh3"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:scaleType="fitXY"

                    android:layout_weight="1"/>

                <ImageView
                    android:visibility="gone"
                    android:id="@+id/hinh4"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:scaleType="fitXY"

                    android:layout_weight="1"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tenDienThoaiCT"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên điện thoại"
                android:textSize="20dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/giaDienThoaiCT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Giá điện thoại"
                android:textSize="20dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hangDienThoaiCT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hãng điện thoại"
                android:textSize="18dp" />

            <TextView
                android:id="@+id/manHinhDienThoaiCT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Màn hình điện thoại"
                android:textSize="18dp" />
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/mausacDienThoaiCT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Màu sắc: "
                    android:textSize="18dp" />

                <TextView
                    android:id="@+id/mau1"
                    android:visibility="gone"
                    android:layout_marginLeft="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Màu 1"
                    android:textSize="18dp" />

                <TextView
                    android:id="@+id/mau2"
                    android:layout_marginLeft="10dp"
                    android:visibility="gone"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Màu 2 "
                    android:textSize="18dp" />

                <TextView
                    android:id="@+id/mau3"
                    android:layout_marginLeft="10dp"
                    android:visibility="gone"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Màu 3 "
                    android:textSize="18dp" />

                <TextView
                    android:id="@+id/mau4"
                    android:layout_marginLeft="10dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Màu 4 "
                    android:textSize="18dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/bonhoDienThoaiCT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bộ nhớ: "
                    android:textSize="18dp" />

                <TextView
                    android:id="@+id/bonho1"
                    android:visibility="gone"
                    android:layout_marginLeft="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18dp" />
                <TextView
                    android:id="@+id/bonho2"
                    android:visibility="gone"
                    android:layout_marginLeft="20dp"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18dp" />
                <TextView
                    android:id="@+id/bonho3"
                    android:visibility="gone"
                    android:layout_marginLeft="20dp"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18dp" />

                <TextView
                    android:id="@+id/bonho4"
                    android:visibility="gone"
                    android:layout_marginLeft="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18dp" />

            </LinearLayout>



            <TextView
                android:id="@+id/osDienThoaiCT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hệ điều hành điện thoại"
                android:textSize="18dp" />

            <TextView
                android:id="@+id/camTruocDienThoaiCT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cam trước điện thoại"
                android:textSize="18dp" />

            <TextView
                android:id="@+id/camSauDienThoaiCT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cam sau điện thoại"
                android:textSize="18dp" />

            <TextView
                android:id="@+id/chipDienThoaiCT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chip điện thoại"
                android:textSize="18dp" />

            <TextView
                android:id="@+id/ramDienThoaiCT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ram điện thoại"
                android:textSize="18dp" />

            <TextView
                android:id="@+id/simDienThoaiCT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sim điện thoại"
                android:textSize="18dp" />

            <TextView
                android:id="@+id/pinSacDienThoaiCT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pin sạc điện thoại"
                android:textSize="18dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/soLuongDienThoaiCT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số lượng"
                    android:textSize="18dp" />
                <EditText
                    android:id="@+id/soluongmua"
                    android:layout_marginLeft="10dp"
                    android:text="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:orientation="horizontal">
                <Button
                    android:layout_margin="12dp"
                    android:onClick="onAddCart"
                    android:layout_width="wrap_content"
                    android:text="Thêm vào giỏ hàng"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"/>

                <Button
                    android:layout_margin="12dp"
                    android:onClick="onBuy"
                    android:layout_width="wrap_content"
                    android:layout_weight="1"
                    android:text="Mua ngay"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

